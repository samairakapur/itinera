# ─── Supabase (required) ─────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...   # "anon / public" key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ─── Edge Function Secrets ────────────────────────────────────────────────────
# Set these via: Supabase dashboard → Edge Functions → Manage secrets
# (these are NEVER in .env — they live only in Supabase's secret store)

# Google Gemini API  (itinerary generation — REQUIRED for AI features)
# Model used: gemini-2.0-flash  |  Free tier: 1,500 requests/day, no credit card
# Get your free key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=AIza...

# Foursquare Places API  (Nearby tab)
# Free tier: 1,000 calls/day — no credit card required
# https://developer.foursquare.com/
FOURSQUARE_API_KEY=your_foursquare_api_key

# Unsplash API  (destination / place images)
# Free tier: 50 requests/hour — no credit card required
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# AviationStack API  (flight-lookup fallback after OpenSky)
# Free tier: 100 requests/month — email signup, no credit card required
# https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# ─── APIs that do NOT need a key ─────────────────────────────────────────────
# Open-Meteo (weather)     — https://open-meteo.com/           free, no key
# OpenSky Network (flights) — https://opensky-network.org/     free, no key
